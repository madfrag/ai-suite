# OpenAI API key, used by the chatbot and summarizer
OPENAI_API_KEY=

# Optional, both default to "gpt-5-nano" if unset
OPENAI_CHAT_MODEL=
OPENAI_SUMMARY_MODEL=

# Optional, per-IP daily caps on OpenAI-backed requests. Default to 30 and 20.
CHAT_DAILY_LIMIT=
SUMMARIZE_DAILY_LIMIT=

# HuggingFace API key, used by the summarizer's HuggingFace provider
HUGGINGFACE_API_KEY=

# Supabase project URL and publishable (anon) key. Server-only: every request
# to Supabase is made by this app's own API routes, never by the browser, so
# these stay unprefixed rather than NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET — server-only, bypasses RLS entirely. Never prefix with NEXT_PUBLIC_,
# never commit a real value, never send to the browser. Used only for the
# IP-keyed rate limiter, which isn't scoped to a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, defaults to "supabase"
NEXT_PUBLIC_DB_PROVIDER=supabase
