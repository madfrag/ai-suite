# OpenAI API key, used by the chatbot and summarizer
OPENAI_API_KEY=

# Optional, both default to "gpt-5-nano" if unset
OPENAI_CHAT_MODEL=
OPENAI_SUMMARY_MODEL=

# Optional, per-IP daily caps on OpenAI-backed requests. Default to 30 and 20.
CHAT_DAILY_LIMIT=
SUMMARIZE_DAILY_LIMIT=

# HuggingFace API key, used by the summarizer's HuggingFace provider
HUGGINGFACE_API_KEY=

# Supabase project URL and publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, defaults to "supabase"
NEXT_PUBLIC_DB_PROVIDER=supabase
